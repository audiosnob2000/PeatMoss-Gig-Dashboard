rules_version = '2';

// Multi-band access rules. NOT deployed: the live rules are the root firestore.rules,
// and the deploy workflow only watches that file. These replace it at the cutover.
//
// Model: everything a band owns lives under bands/{bandId}. A person's role in a band is
// the document bands/{bandId}/members/{uid}, written only by Cloud Functions (Admin SDK),
// never by a client. So "is this person in this band" is one lookup, and a query that
// forgets the band reads nothing instead of reading someone else's data.
//
// Roles: owner, admin, member. (No read-only fill-in role: a sub gets a text message.)
//
// Billing is per person. The server marks a member "covered: false" when their own
// subscription lapses. That person is locked out of the band's content entirely: no gigs,
// charts, sets, or member list. They can still see the band's name, their own membership
// record (so the app can say "subscribe to continue"). Mileage is not part of a band at all:
// it lives under the person (users/{uid}/mileageTrips). A missing field means covered (trial, new member). Where
// coverage comes from (own plan today, a group seat later) is invisible to these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(bandId) { return /databases/$(database)/documents/bands/$(bandId)/members/$(request.auth.uid); }

    function isMember(bandId) { return signedIn() && exists(memberPath(bandId)); }
    function memberData(bandId) { return get(memberPath(bandId)).data; }
    function covered(bandId) { return memberData(bandId).get('covered', true) != false; }
    // A member whose own subscription is current. Everything below that touches band
    // content goes through this, so an uncovered person gets nothing.
    function active(bandId) { return isMember(bandId) && covered(bandId); }
    function hasRole(bandId, roles) { return active(bandId) && memberData(bandId).role in roles; }
    function isManager(bandId) { return hasRole(bandId, ['owner', 'admin']); }
    function isPlayer(bandId) { return hasRole(bandId, ['owner', 'admin', 'member']); }

    function mine(data) { return data.get('uid', '') == request.auth.uid; }
    function uidUnchanged() { return request.resource.data.get('uid', '') == resource.data.get('uid', ''); }

    match /bands/{bandId} {
      // Name and trial info only; an uncovered member needs it to see the subscribe screen.
      allow read: if isMember(bandId);
      // Created and deleted only by Cloud Functions. Admins may change these fields and
      // nothing else: owner, billing, createdAt and the rest are server-only.
      allow update: if isManager(bandId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'timeZone', 'calendarId', 'publicScheduleEnabled']);
      allow create, delete: if false;

      match /members/{uid} {
        allow read: if active(bandId) || (isMember(bandId) && request.auth.uid == uid);
        allow write: if false;
      }

      match /invites/{code} {
        allow read: if isManager(bandId);
        allow write: if false;
      }

      match /gigs/{id} {
        allow read, create, update, delete: if isPlayer(bandId);
      }

      match /setlists/{id} {
        allow read, create, update, delete: if isPlayer(bandId);
      }

      match /unavailableDates/{id} {
        allow read: if isPlayer(bandId);
        allow create: if isPlayer(bandId) && mine(request.resource.data);
        allow update, delete: if isPlayer(bandId) && mine(resource.data);
      }

      // Charts. A private chart is readable and editable only by whoever made it, enforced
      // here rather than by hiding it on the phone. A client must ask for shared charts and
      // its own separately (two queries), because rules are not filters. A chart counts as
      // shared only if it says so explicitly: defaulting a missing field to "shared" makes
      // the engine accept an unfiltered list that includes private charts (tested).
      match /songs/{id} {
        allow read: if isPlayer(bandId)
          && (resource.data.get('shared', false) == true || mine(resource.data));
        allow create: if isPlayer(bandId) && mine(request.resource.data);
        allow update: if isPlayer(bandId) && uidUnchanged()
          && (resource.data.get('shared', false) == true || mine(resource.data));
        allow delete: if isPlayer(bandId)
          && (resource.data.get('shared', false) == true || mine(resource.data));
      }

      // Band-wide settings such as the stage plot.
      match /settings/{doc} {
        allow read: if isPlayer(bandId);
        allow write: if isManager(bandId);
      }

      // Personal bookkeeping, never visible to anyone else.
      match /checklists/{uid} {
        allow read, write: if isPlayer(bandId) && request.auth.uid == uid;
      }
      match /unpaidGigs/{uid} {
        allow read, write: if isPlayer(bandId) && request.auth.uid == uid;
      }

      // A phone registers its own push token. Nobody can read tokens back; only the
      // reminder functions (Admin SDK) do. An uncovered person can remove theirs, not add one.
      match /fcmTokens/{token} {
        allow read: if false;
        allow create: if isPlayer(bandId) && mine(request.resource.data);
        allow update: if isPlayer(bandId) && mine(resource.data) && uidUnchanged();
        allow delete: if isMember(bandId) && mine(resource.data);
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
      match /memberships/{bandId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      // Mileage belongs to the person, not to any band: one year total for taxes however many
      // bands you play in, and nothing is lost when you leave one. No band can reach it, because
      // it is not in a band's area at all. Deliberately not tied to a subscription: it is the
      // person's own record (the app does not offer it behind the locked-out screen).
      match /mileageTrips/{tripId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Google refresh tokens and similar. Server only.
      match /private/{doc=**} {
        allow read, write: if false;
      }
    }

    // Everything else (sentReminders, stripeCustomers, stripeEvents, and today's flat
    // collections) is closed. A collection nobody wrote a rule for fails shut, not open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
